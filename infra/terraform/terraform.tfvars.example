# Default profile: personal AWS account.
# cp terraform.tfvars.example terraform.tfvars
# Academy: cp terraform.tfvars.academy.example terraform.tfvars

aws_region         = "us-east-1"
cluster_name       = "techchallenge-eks"
kubernetes_version = "1.31"

use_lab_role         = false
create_iam_resources = true

node_instance_types = ["t3.small"]
node_capacity_type  = "SPOT"
node_desired_size   = 2
node_min_size       = 1
node_max_size       = 2
node_disk_size      = 20
coredns_replica_count = 1

enable_ebs_csi = true

allowed_api_cidr = "0.0.0.0/0"

# JWT auth via API Gateway + Lambda
# Em CI: valores sensíveis vêm de GitHub Secrets via TF_VAR_* no workflow terraform.yml
# Secrets:  JWT_SECRET, AUTH_EMAIL, AUTH_PASSWORD
# Variables: ENABLE_AUTH_GATEWAY=true, JWT_EXPIRES_IN (opcional)
# eks_backend_url é derivado automaticamente do IP público do node EKS (:30080)
enable_auth_gateway = false
