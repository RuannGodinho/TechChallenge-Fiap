# Default profile: personal AWS account.
# cp terraform.tfvars.example terraform.tfvars
# Academy: cp terraform.tfvars.academy.example terraform.tfvars

aws_region         = "us-east-1"
cluster_name       = "techchallenge-eks"
kubernetes_version = "1.31"

use_lab_role         = false
create_iam_resources = true

node_instance_types = ["t3.small"]
node_capacity_type  = "SPOT"
node_desired_size   = 2
node_min_size       = 1
node_max_size       = 2
node_disk_size      = 20
coredns_replica_count = 1

enable_ebs_csi = true

allowed_api_cidr = "0.0.0.0/0"

# JWT auth via API Gateway + Lambda
# enable_auth_gateway: do NOT set here — default is false in variables-auth.tf.
# In CI: set GitHub Variable ENABLE_AUTH_GATEWAY=true (maps to TF_VAR_enable_auth_gateway).
# Secrets via TF_VAR_*: JWT_SECRET, AUTH_EMAIL, AUTH_PASSWORD, GATEWAY_TRUST_SECRET
# Optional variable: JWT_EXPIRES_IN (default 1h)
# eks_backend_url is derived automatically from the EKS node public IP (:30080)
