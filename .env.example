PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/Node-Fiap
NODE_ENV=development

JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
AUTH_MODE=local

# Em Kubernetes/AWS (AUTH_MODE=gateway): o login por CPF fica na Lambda AuthSign.
# GATEWAY_TRUST_SECRET must match between API Gateway (Terraform) and the Express pod (K8s secret).
GATEWAY_TRUST_SECRET=change-me-trust-secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-app-password
SMTP_FROM=seu-email@gmail.com
ORCAMENTO_EMAIL_TO=seu-email@exemplo.com
